   "source": [
    "def right_triangle(a,b,c):\n",
    "    if a*a+b*b==c*c or a*a+c*c==b*b or b*b+c*c==a*a:\n",
    "        print(\"right angle triangle\")\n",
    "    else:\n",
    "        print(\"not right angle triangle\")\n",
    "right_triangle(3,4,5)"
   ]
